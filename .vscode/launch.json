{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api: build",
      "program": "${workspaceFolder}/src/LessonOrganizer.Api/bin/Debug/net10.0/LessonOrganizer.Api.dll",
      "cwd": "${workspaceFolder}/src/LessonOrganizer.Api",
      "launchSettingsProfile": "https",
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "frontend: start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "API + Frontend",
      "configurations": ["API", "Frontend"],
      "stopAll": true
    }
  ]
}
